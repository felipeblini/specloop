{
  "name": "specloop",
  "version": "0.7.0",
  "description": "OpenSpec planning for Claude Code: tasks.md where every task and test declares its files, ready for an external loop (loop.mjs + judge.mjs).",
  "license": "BSD-3-Clause",
  "author": "Wenqing Yu",
  "keywords": [
    "openspec",
    "ai",
    "claude",
    "claude-code",
    "spec-driven",
    "ai-coding",
    "ai-assistant",
    "loop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipeblini/specloop.git"
  },
  "bin": {
    "specloop": "bin/specloop.js"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "node --enable-source-maps dist/index.js --help",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
